{
  "name": "matrixprime-client",
  "version": "1.3.4",
  "author": "MathPRIME",
  "description": "Matrix Client for MineFun.io — MathPRIME Edition with custom player tags, translation and integrated visual mods",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never",
    "build-all": "electron-builder --win --linux --publish never",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "io.mathprime.matrixclient",
    "productName": "Matrix Client",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/assets/icon.png",
      "category": "Game"
    },
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "asar": true
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}
